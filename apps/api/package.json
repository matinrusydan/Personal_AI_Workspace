{
  "name": "@paw/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS Modular Monolith API for Personal AI Workspace",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "node ../../scripts/watch-runner.mjs dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@paw/config": "workspace:*",
    "@paw/contracts": "workspace:*",
    "@paw/database": "workspace:*",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
