{
  "name": "@paw/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background BullMQ workers, outbox dispatcher, and reminder processors for Personal AI Workspace",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "node ../../scripts/watch-runner.mjs dist/main.js",
