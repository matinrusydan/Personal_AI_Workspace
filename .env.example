# ==============================================================================
# Personal AI Workspace — Environment Configuration (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS OR TOKENS TO SOURCE CONTROL
# ==============================================================================

# Core Runtime
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# PostgreSQL (Matches docker-compose.yml local service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paw_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paw_dev
POSTGRES_PORT=5432

# Redis / BullMQ (Matches docker-compose.yml local service)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Security & Authentication (ADR-014)
# Generate a secure 32+ character random string in production: openssl rand -base64 32
JWT_SECRET=dev-secret-must-be-changed-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Owner Authorization Allowlist
OWNER_EMAIL=owner@example.com

# Integrations (Optional in Phase 1 / Disabled by default)
# TELEGRAM_BOT_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
