# ==============================================================================
# Personal AI Workspace — Environment Configuration (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT REAL SECRETS OR TOKENS TO SOURCE CONTROL
# ==============================================================================

# Core Runtime
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# PostgreSQL (Matches docker-compose.yml local service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paw_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paw_dev
POSTGRES_PORT=5432

# Redis / BullMQ (Matches docker-compose.yml local service)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Security & Authentication (ADR-014)
# Fill these locally; never commit the generated values.
# AUTH_ENCRYPTION_KEY: exactly 32 random bytes encoded as 64 hexadecimal characters.
# AUTH_SETUP_TOKEN: high-entropy one-time secret, minimum 32 characters.
AUTH_ENCRYPTION_KEY=
AUTH_BOOTSTRAP_ENABLED=false
AUTH_SETUP_TOKEN=
APP_ORIGIN=http://localhost:3000
PAW_API_URL=http://127.0.0.1:4000/api/v1/

# Explicit owner identity. Placeholder/example addresses are rejected by the API.
OWNER_EMAIL=

# Integrations (Optional in Phase 1 / Disabled by default)
# TELEGRAM_BOT_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
